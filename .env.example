# Server-only configuration. Never put secrets in NEXT_PUBLIC_* variables.
# Chat-completions-compatible endpoint, model and server bearer credential:
TUTOR_API_URL=
TUTOR_API_TOKEN=
TUTOR_MODEL=
# Provider adapter endpoint accepts {text,rate,language} and returns audio/*.
# It can normalize Azure/Google/ElevenLabs/OpenAI TTS upstream formats.
TTS_API_URL=
TTS_API_TOKEN=

# Direct Azure Japanese Neural TTS (optional; takes precedence over generic adapter)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=ja-JP-NanamiNeural

# DeepSeek native integration. Server-only; do not use NEXT_PUBLIC_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
